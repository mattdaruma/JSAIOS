{
  "system": {
    "name": "JSAIOS OS Daemon",
    "version": "1.0.0",
    "environment": "daemon"
  },
  "daemon": {
    "enabled": true,
    "port": 3001,
    "host": "127.0.0.1",
    "mode": "http",
    "pipeName": "\\\\.\\pipe\\jsaiosd",
    "security": {
      "requireAuth": true,
      "authToken": "jsaios-daemon-secret-token"
    },
    "ipcGateway": true,
    "logging": {
      "level": "info",
      "logFile": "storage/logs/jsaiosd.log",
      "logToConsole": true
    },
    "cors": {
      "enabled": true,
      "allowOrigin": "*",
      "allowMethods": "GET, POST, OPTIONS, PUT, DELETE",
      "allowHeaders": "Content-Type, Authorization, X-Requested-With"
    }
  },
  "engines": [
    {
      "id": "chat",
      "type": "chat",
      "storageDir": "storage/chat-sessions",
      "enabled": true
    }
  ],
  "services": [
    {
      "id": "ollama",
      "type": "ai",
      "driver": "OllamaService",
      "endpoint": "http://localhost:11434",
      "enabled": true
    },
    {
      "id": "comfyui",
      "type": "ai",
      "driver": "ComfyUIService",
      "endpoint": "http://localhost:8188",
      "enableWebSocket": true,
      "enabled": true
    },
    {
      "id": "copilot",
      "type": "ai",
      "driver": "CopilotService",
      "endpoint": "local",
      "enabled": true
    }
  ],
  "shells": [
    {
      "id": "terminal",
      "type": "cli",
      "enabled": true
    },
    {
      "id": "browser-daemon",
      "type": "browser",
      "mode": "daemon-client",
      "endpoint": "http://127.0.0.1:3001",
      "enabled": true
    },
    {
      "id": "browser-local",
      "type": "browser",
      "mode": "in-browser-kernel",
      "requiresSecrets": false,
      "enabled": true
    }
  ]
}

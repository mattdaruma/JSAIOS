{
  "version": "1.0.0",
  "cors": {
    "enabled": true,
    "allowOrigin": "*",
    "allowMethods": "GET, POST, OPTIONS",
    "allowHeaders": "Content-Type, Authorization"
  },
  "routes": [
    {
      "id": "terminal-command",
      "path": "/api/command",
      "method": "POST",
      "target": "terminalInterpreter.execute",
      "stream": true
    },
    {
      "id": "status",
      "path": "/api/status",
      "method": "GET",
      "target": "kernel.getStatus"
    },
    {
      "id": "services",
      "path": "/api/services",
      "method": "GET",
      "target": "kernel.getStatus"
    },
    {
      "id": "list-sessions",
      "path": "/api/chat/sessions",
      "method": "GET",
      "target": "chatEngine.listSessions"
    },
    {
      "id": "create-session",
      "path": "/api/chat/sessions",
      "method": "POST",
      "target": "chatEngine.createSession"
    },
    {
      "id": "chat-history",
      "path": "/api/chat/history",
      "method": "GET",
      "target": "chatEngine.listSessions"
    },
    {
      "id": "chat-send-stream",
      "path": "/api/chat/send",
      "method": "POST",
      "target": "chatEngine.executeTurn",
      "stream": true
    }
  ]
}

{
  "system": {
    "name": "JSAIOS",
    "version": "1.0.0",
    "environment": "cli"
  },
  "services": [
    {
      "id": "ollama",
      "type": "ai",
      "driver": "OllamaService",
      "endpoint": "http://localhost:11434",
      "enabled": true
    },
    {
      "id": "comfyui",
      "type": "ai",
      "driver": "ComfyUIService",
      "endpoint": "http://localhost:8188",
      "enabled": true
    },
    {
      "id": "copilot",
      "type": "ai",
      "driver": "CopilotService",
      "endpoint": "local",
      "enabled": true
    }
  ],
  "engines": {
    "chat": {
      "storageDir": "chat-sessions"
    }
  },
  "shell": {
    "type": "cli",
    "prompt": "jsaios@honeykernel:~$ "
  }
}

{
  "system": {
    "name": "JSAIOS",
    "version": "1.0.0",
    "environment": "server"
  },
  "daemon": {
    "enabled": true,
    "port": 3001,
    "host": "127.0.0.1",
    "ipcGateway": true
  },
  "servers": [
    {
      "id": "http-rest",
      "port": 3000,
      "host": "localhost",
      "routesFile": "config/jsaios.routes.json",
      "enabled": true,
      "cors": {
        "enabled": true,
        "allowOrigin": "*",
        "allowMethods": "GET, POST, OPTIONS",
        "allowHeaders": "Content-Type, Authorization"
      }
    }
  ],
  "engines": [
    {
      "id": "chat",
      "type": "chat",
      "storageDir": "chat-sessions",
      "enabled": true
    }
  ],
  "services": [
    {
      "id": "ollama",
      "type": "ai",
      "driver": "OllamaService",
      "endpoint": "http://localhost:11434",
      "enabled": true
    },
    {
      "id": "comfyui",
      "type": "ai",
      "driver": "ComfyUIService",
      "endpoint": "http://localhost:8188",
      "enabled": true
    },
    {
      "id": "copilot",
      "type": "ai",
      "driver": "CopilotService",
      "endpoint": "local",
      "enabled": true
    }
  ],
  "shells": [
    {
      "id": "terminal",
      "type": "cli",
      "prompt": "jsaios@honeykernel:~$ ",
      "enabled": true
    },
    {
      "id": "browser-daemon",
      "type": "browser",
      "mode": "daemon-client",
      "endpoint": "http://127.0.0.1:3001",
      "prompt": "jsaios@honeykernel:~$ ",
      "enabled": true
    },
    {
      "id": "browser-local",
      "type": "browser",
      "mode": "in-browser-kernel",
      "requiresSecrets": false,
      "prompt": "jsaios@honeykernel:~$ ",
      "enabled": true
    }
  ]
}
